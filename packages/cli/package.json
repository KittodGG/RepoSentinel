{
  "name": "@reposentinel/cli",
  "version": "0.1.0-dev.1",
  "private": true,
  "type": "module",
  "bin": {
    "reposentinel": "dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsx src/index.ts",
    "lint": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "@reposentinel/config": "workspace:*",
    "@reposentinel/core": "workspace:*",
    "@reposentinel/i18n": "workspace:*",
    "@reposentinel/rules": "workspace:*",
    "commander": "^14.0.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.3"
  }
}
