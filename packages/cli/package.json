{
  "name": "reposentinel",
  "version": "1.1.0",
  "private": false,
  "description": "Local-first, multilingual repository readiness CLI",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "bin": {
    "reposentinel": "dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "lint": "pnpm exec biome check src",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "commander": "^15.0.0",
    "ignore": "^7.0.9",
    "picocolors": "^1.1.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@reposentinel/config": "workspace:*",
    "@reposentinel/dashboard": "workspace:*",
    "@reposentinel/core": "workspace:*",
    "@reposentinel/i18n": "workspace:*",
    "@reposentinel/reporters": "workspace:*",
    "@reposentinel/rules": "workspace:*",
    "@types/node": "^26.5.1",
    "tsx": "^4.23.13"
  }
}
