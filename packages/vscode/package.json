{
  "name": "reposentinel-diagnostics",
  "private": true,
  "displayName": "RepoSentinel Diagnostics",
  "publisher": "kittodgg",
  "version": "1.0.0",
  "description": "VS Code diagnostics adapter for RepoSentinel JSON reports",
  "license": "MIT",
  "categories": ["Linters"],
  "engines": { "vscode": "^1.103.0" },
  "repository": { "type": "git", "url": "https://github.com/KittodGG/RepoSentinel" },
  "type": "module",
  "main": "dist/extension.cjs",
  "files": ["dist", "package.json", "README.md", "LICENSE"],
  "contributes": {
    "commands": [
      {
        "command": "reposentinel.scan",
        "title": "RepoSentinel: Scan Workspace"
      }
    ]
  },
  "activationEvents": ["onCommand:reposentinel.scan"],
  "scripts": {
    "build": "tsup src/extension.ts --format cjs --external vscode --clean",
    "package": "pnpm build && vsce package",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/vscode": "^1.103.0",
    "@vscode/vsce": "^3.6.0",
    "tsup": "^8.5.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
