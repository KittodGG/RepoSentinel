{
  "name": "reposentinel-workspace",
  "version": "0.1.0-beta.2",
  "private": true,
  "description": "RepoSentinel local-first repository readiness CLI workspace",
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "pack:alpha": "pnpm --filter reposentinel build && node scripts/pack-alpha.mjs",
    "pack:beta": "pnpm --filter reposentinel build && node scripts/pack-alpha.mjs",
    "release:gate": "pnpm typecheck && pnpm test && pnpm build && pnpm pack:beta && node scripts/release-gate.mjs",
    "benchmark": "pnpm --filter reposentinel build && node scripts/benchmark.mjs . 5",
    "dogfood": "pnpm --filter reposentinel build && node scripts/dogfood.mjs",
    "dev": "pnpm --filter reposentinel dev",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm build && pnpm -r typecheck"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4",
    "yaml": "^2.9.0"
  }
}
