{
  "name": "reposentinel-workspace",
  "version": "1.1.0",
  "private": true,
  "description": "RepoSentinel local-first repository readiness CLI workspace",
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "pack:release": "pnpm --filter reposentinel build && node scripts/pack-release.mjs",
    "release:gate": "pnpm typecheck && pnpm test && pnpm build && pnpm pack:release && node scripts/release-gate.mjs",
    "benchmark": "pnpm --filter reposentinel build && node scripts/benchmark.mjs . 5",
    "test:stable-matrix": "node scripts/stable-matrix.mjs",
    "test:corpus": "pnpm --filter reposentinel build && node scripts/corpus-check.mjs",
    "release:gate:full": "pnpm release:gate && pnpm test:corpus",
    "dogfood": "pnpm --filter reposentinel build && node scripts/dogfood.mjs",
    "dev": "pnpm --filter reposentinel dev",
    "lint": "pnpm exec biome check packages scripts",
    "test": "pnpm -r test",
    "test:coverage": "pnpm exec vitest run --coverage",
    "typecheck": "pnpm build && pnpm -r typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "4.1.10",
    "tsup": "^8.5.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  }
}
